{
  "name": "medication-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seed.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:api-build": "node scripts/check-api-build.mjs",
    "build": "vite build --config apps/web/vite.config.ts",
    "build:vercel": "node --import tsx scripts/vercel-build.ts",
    "configure:hosted": "node --import tsx scripts/configure-hosted.ts",
    "check:live": "node --import tsx scripts/check-live.ts",
    "deploy:hosted": "node --import tsx scripts/deploy-hosted.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "monitor": "tsx scripts/monitor.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "retention": "tsx scripts/retention.ts",
    "verify": "npm run migrate && npm run seed && npm run typecheck && npm test && npm run build && npm run test:browser"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/functions": "3.9.11",
    "dexie": "4.4.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "luxon": "3.7.2",
    "pdfmake": "0.3.11",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "uuid": "14.0.3",
    "web-push": "3.6.7",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/pdfmake": "0.3.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
