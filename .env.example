NODE_ENV=development
LOCAL_DEMO=true
DATABASE_URL=postgres://medication:local-only@localhost:5432/medication
PUBLIC_APP_URL=http://localhost:5173
PORT=3001
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRIVATE_PHOTO_BUCKET=medication-photos
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
PUSH_ADAPTER=webpush
REMINDER_FRESHNESS_SECONDS=900
# Exact push service hostnames, no arbitrary URLs
PUSH_ALLOWED_HOSTS=web.push.apple.com,fcm.googleapis.com,updates.push.services.mozilla.com

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PUSH_ENCRYPTION_KEY=

# Separate key for encrypted pg_dump backups; store independently of backup files.
BACKUP_ENCRYPTION_KEY=
BACKUP_LOCAL_DOCKER=false
