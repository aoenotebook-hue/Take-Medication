# Copy to .env.production on the deployment host; do not commit that file.
APP_DOMAIN=medication.your-owned-domain.example
ACME_EMAIL=owner@your-owned-domain.example
PUBLIC_APP_URL=https://medication.your-owned-domain.example
DATABASE_URL=postgresql://runtime-user:password@private-postgres:5432/medication?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-credential
VITE_SUPABASE_ANON_KEY=replace-with-public-publishable-key
PRIVATE_PHOTO_BUCKET=medication-photos
VAPID_PUBLIC_KEY=replace-with-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-generated-vapid-private-key
VAPID_SUBJECT=mailto:owner@your-owned-domain.example
PUSH_ENCRYPTION_KEY=replace-with-32-byte-base64-key
BACKUP_ENCRYPTION_KEY=replace-with-separate-32-byte-base64-key
REMINDER_FRESHNESS_SECONDS=900
PUSH_ALLOWED_HOSTS=web.push.apple.com,fcm.googleapis.com,updates.push.services.mozilla.com
# Optional prebuilt image. Build locally when public auth values change.
APP_IMAGE=medication-companion:release
