# Load through the environment secret manager or Node --env-file=.env.hosted.
# Never commit the populated file or paste these credentials into chat.
NODE_ENV=production
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
# Trusted administrator connection for provisioning only. Use the project
# Connect panel's session/transaction pooler URL and verify the TLS certificate.
DATABASE_URL=postgresql://postgres.qfiplelamyjwvexosmii:replace-with-password@replace-with-pooler-host:5432/postgres?sslmode=verify-full
# Optional PEM CA if required by the selected database certificate chain.
DATABASE_SSL_CA=
# Optional: choose an existing production domain; otherwise discover it.
PUBLIC_APP_URL=
# Set after the exact commit passes Verification in GitHub Actions.
DEPLOY_COMMIT=
